# Sao chép thành .env rồi điền giá trị thật.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_DEFAULT_MODEL=deepseek-v4-pro

DATABASE_URL=postgresql://local_translate:change-me@127.0.0.1:5432/local_translate

APP_HOST=127.0.0.1
APP_PORT=8000
DATA_DIR=~/LocalTranslate

# Database riêng cho test (mặc định: cùng server, tên local_translate_test)
TEST_DATABASE_URL=
POSTGRES_PASSWORD=change-me
# Đổi nếu cổng 5432 đã bị dùng (nhớ sửa cả DATABASE_URL)
POSTGRES_PORT=5432

# CTranslate2 (HachimiMT): luồng CPU. Mặc định đã đo trên M5.
CT2_INTRA_THREADS=8
CT2_INTER_THREADS=1
